meta {
  name: Crear bloqueo
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}{{base_url}}/bloqueos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id_cancha": 1,
    "fecha": "2026-10-15",
    "hora_inicio": "10:00:00",
    "hora_fin": "12:00:00",
    "motivo": "Mantenimiento de iluminación"
  }
}

docs {
  Crea un bloqueo de mantenimiento para una cancha en un intervalo determinado.
}
