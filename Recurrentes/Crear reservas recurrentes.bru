meta {
  name: Crear reservas recurrentes
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}{{base_url}}/reservas/recurrentes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id_socio": 1,
    "id_cancha": 1,
    "fecha_hora_inicio": "2026-10-15T18:00:00.000000-03:00",
    "fecha_hora_fin": "2026-10-15T20:00:00.000000-03:00",
    "cantidad_semanas": 4
  }
}

docs {
  Crea una serie de reservas semanales si todos los horarios están disponibles.
}
