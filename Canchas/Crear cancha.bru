meta {
  name: Crear cancha
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}{{base_url}}/canchas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Cancha 5 - Pádel",
    "id_deporte": 4,
    "precio_hora": 750000,
    "techada": true,
    "activa": true
  }
}

docs {
  Crea una nueva cancha asociada a un deporte existente.
}
